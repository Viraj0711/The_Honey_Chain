# Canonical API environment file: backend/api/.env.example
# The backend reads backend/api/.env when started from its workspace.

PORT=4000
NODE_ENV=development

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

GOOGLE_APPLICATION_CREDENTIALS=/path/to/honeychain-3630b-firebase-adminsdk-*.json
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=https://honeychain-3630b-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=honeychain-3630b
FIREBASE_STORAGE_BUCKET=honeychain-3630b.firebasestorage.app
FIREBASE_EMULATOR_HOST=

WEB_ORIGIN=http://localhost:5173
PUBLIC_WEB_ORIGIN=http://localhost:5173

HIVE_ID=NODE_01
BATCH_ID=
NODE_OFFLINE_AFTER_MS=30000
TELEMETRY_RETENTION_DAYS=30

CHAIN_RPC_URL=http://127.0.0.1:8545
HONEY_BATCH_CONTRACT=
POLLINATION_ESCROW=
RECONCILER_PRIVATE_KEY=
