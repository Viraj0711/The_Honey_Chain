{
  "name": "honey-chain",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend/api",
    "backend/contracts"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace backend/api",
    "build:api": "npm run build --workspace backend/api",
    "typecheck:api": "npm run typecheck --workspace backend/api",
    "seed": "npm run seed --workspace backend/api",
    "capture": "npm run capture --workspace backend/api",
    "chain:node": "npm run node --workspace backend/contracts",
    "chain:test": "npm run test --workspace backend/contracts",
    "chain:compile": "npm run compile --workspace backend/contracts",
    "chain:deploy": "npm run deploy:local --workspace backend/contracts",
    "dev:honeychain": "npm run dev --prefix frontend --",
    "build:honeychain": "npm run build --prefix frontend",
    "lint:honeychain": "npm run lint --prefix frontend",
    "preview:honeychain": "npm run preview --prefix frontend",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "firebase-tools": "^15.31.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "keccak@3.0.4": true,
    "secp256k1@4.0.5": true,
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true,
    "re2@1.24.1": true
  }
}
