{
  "name": "honey-chain",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:honeychain": "npm run dev --prefix frontend --",
    "build:honeychain": "npm run build --prefix frontend",
    "lint:honeychain": "npm run lint --prefix frontend",
    "preview:honeychain": "npm run preview --prefix frontend",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "seed": "npm run seed --workspace apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  }
}
